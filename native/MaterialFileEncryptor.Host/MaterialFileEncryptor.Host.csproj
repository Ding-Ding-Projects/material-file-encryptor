<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>MaterialFileEncryptor.Host</AssemblyName>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../src/features/server-manager/runtime-provenance.json" LogicalName="MaterialFileEncryptor.ServerRuntimeManifest" />
    <EmbeddedResource Include="../../src/main/ollama-runtime-files.json" LogicalName="MaterialFileEncryptor.OllamaRuntimeFiles" />
    <ProjectReference Include="../MaterialFileEncryptor.Core/MaterialFileEncryptor.Core.csproj" />
    <ProjectReference Include="../vendor/WinFsp/WinFsp.Binding.csproj" />
  </ItemGroup>
</Project>
