{
  "name": "material-file-encryptor",
  "version": "0.1.0",
  "description": "Encrypted storage mounted as a Windows drive with WinFsp.",
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:desktop": "node scripts/desktop-check.mjs",
    "check": "node --test test/desktop*.test.js",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "electron": "44.7.0",
    "playwright": "1.64.0"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "electron-squirrel-startup": "1.0.1"
  }
