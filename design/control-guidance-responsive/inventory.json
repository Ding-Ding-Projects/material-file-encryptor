  "states": [
    {
      "id": "guidance-collapsed",
      "expected": "One information icon above the exact target, no persistent Guide or Explain labels; localized name and 48px touch target."
    },
    {
      "id": "information-tooltip-hover-focus",
      "expected": "Localized target-specific tooltip appears on hover and keyboard focus, fits viewport and dismisses on exit, Escape or panel opening; accessible name remains independent."
    },
    {
      "id": "guidance-open",
      "expected": "Non-modal full-width panel above target; title focused; direct control remains reachable."
    },
    {
      "id": "explanation-expanded",
      "expected": "All contextual explanation fields and authoritative help link resolve correctly."
    },
    {
      "id": "worked-example",
      "expected": "Explicit authored sample input, action and expected output describe the exact target concept."
    },
    {
      "id": "practice-initial",
      "repeatFor": "practiceKinds",
      "expected": "Authored fixture only, with no live values or production callbacks."
    },
    {
      "id": "practice-edited",
      "repeatFor": "practiceKinds",
      "expected": "Functional control-specific change and visible local result, without external effects."
    },
    {
      "id": "practice-invalid",
      "repeatFor": "applicable validating practiceKinds",
      "expected": "Local validation identifies the sample field; real target is unchanged; recovery remains possible."
    },
    {
      "id": "practice-reset",
      "repeatFor": "practiceKinds",
      "expected": "Reset restores the exact authored fixture without storage, history or original-control changes."
    },
    {
      "id": "practice-concurrent-same-descriptor",
      "expected": "Two instances own separate drafts, fixtures, popups, listeners and cancellation; editing or resetting one changes neither the other nor any real target."
    },
    {
      "id": "practice-concurrent-different-descriptors",
      "expected": "Different descriptor instances cannot share drafts or cross-route helper and admission calls."
    },
    {
      "id": "practice-close-reopen",
      "expected": "Closing disposes all sample state and reopening restores the authored fixture with no previous input."
    },
    {
      "id": "practice-observed-side-effects",
      "expected": "Observed production callback, network/IPC, storage/history and native-operation counters remain unchanged during sample edit, validation, reset and disposal."
    },
    {
      "id": "target-disabled",
      "expected": "Information and practice remain available; real action is unavailable with its specific reason."
    },
    {
      "id": "target-readonly",
      "expected": "Explanation remains accessible; practice is synthetic; original value cannot be changed."
    },
    {
      "id": "real-action-first-step",
      "expected": "Explicit entry opens real operation guidance with target availability and validation intact."
    },
    {
      "id": "real-action-next-back",
      "expected": "Progress and Back preserve valid drafts and appropriate focus."
    },
    {
      "id": "real-action-invalid",
      "expected": "Invalid real input prevents advancement and focuses the affected real field."
    },
    {
      "id": "real-action-confirm",
      "expected": "Only explicit final activation invokes the original admitted operation with its permissions and confirmations."
    },
    {
      "id": "real-action-finished",
      "expected": "Actual awaited outcome is announced; practice completion never implies real success."
    },
    {
      "id": "real-action-cancelled",
      "expected": "Pending work cancels safely; completed effects are not falsely described as rolled back."
    },
    {
      "id": "guidance-closed",
      "expected": "Focus returns to information button; all practice state and listeners are disposed."
    },
    {
      "id": "personalization-tab-help",
      "expected": "Every tab including inactive tabs retains its own above-control information entry; only the full-width expanded panel may be shared, with explicit originating-tab association and prior-instance disposal."
    },
    {
      "id": "public-navigation-open",
      "expected": "Menu follows actual header geometry, fits available viewport and supports Escape and destination focus."
    },
    {
      "id": "workspace-navigation-open",
      "expected": "Navigation and content remain reachable at narrow widths without document overflow."
    },
    {
      "id": "preferences-dialog-open",
      "expected": "Close and actions remain reachable; content wraps and scrolls within available visual viewport."
    }
  ],
